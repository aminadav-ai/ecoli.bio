{
  "name": "e-coli3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/compile_bounds.js && node scripts/generate_guest_state.js",
    "dev": "vite",
    "prebuild": "node scripts/compile_bounds.js && node scripts/generate_guest_state.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "npx wrangler dev",
    "d1:migrate:local": "npx wrangler d1 migrations apply ecoli_db --local",
    "d1:migrate:remote": "npx wrangler d1 migrations apply ecoli_db --remote"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "highs": "^1.14.2",
    "pixi.js": "^8.18.1"
  }
}
